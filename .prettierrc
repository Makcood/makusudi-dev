{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "tailwindPreserveWhitespace": false,
  "tailwindPreserveDuplicates": false,
  "tailwindFunctions": ["clsx", "tw"],
  "tailwindStylesheet": "./styles/globals.css",
  "plugins": ["prettier-plugin-tailwindcss"]
}
